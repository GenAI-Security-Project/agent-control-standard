{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "env ACS_GUARDIAN_URL=http://127.0.0.1:8787/acs ACS_HMAC_SECRET_FILE=/absolute/path/to/.acs/hmac.key ACS_HMAC_KEY_ID=2026-11 ACS_AUDIT_FILE=/absolute/path/to/.acs/audit.log ACS_DEFAULT_DENY=1 /absolute/path/to/acs-codex-hook",
            "timeout": 30,
            "statusMessage": "Checking command with ACS Guardian"
          }
        ]
      }
    ]
  }
}
